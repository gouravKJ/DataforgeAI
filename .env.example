# ── Database ────────────────────────────────────────────────────────────────
# Local zero-config (default — no server needed, creates prisma/dev.db):
# DATABASE_URL="file:./dev.db"
# Production (Render / Neon / Supabase / Railway):
DATABASE_URL="postgresql://user:pass@host:5432/dataforge"

# ── AI (optional) ───────────────────────────────────────────────────────────
# Leave GROQ_API_KEY empty to run on the deterministic local AI engine.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# ── Security ────────────────────────────────────────────────────────────────
# Long random string used to sign session tokens. Required in production.
APP_SECRET="change-me"
